{
  "name": "walletchan",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:extension": "pnpm --filter @walletchan/extension dev",
    "dev-sepolia:extension": "pnpm --filter @walletchan/extension dev:sepolia",
    "dev:extension-preview": "pnpm --filter @walletchan/extension dev:preview",
    "dev:website": "pnpm --filter @walletchan/website dev",
    "dev:docs": "pnpm --filter @walletchan/docs dev",
    "build": "pnpm build:extension && pnpm build:website",
    "build:extension": "pnpm --filter @walletchan/extension build",
    "build-sepolia:extension": "pnpm --filter @walletchan/extension build:sepolia",
    "build:extension:firefox": "pnpm --filter @walletchan/extension build:firefox",
    "dev:extension:firefox": "pnpm --filter @walletchan/extension dev:firefox",
    "build:website": "pnpm --filter @walletchan/website build",
    "build:docs": "pnpm --filter @walletchan/docs build",
    "lint": "pnpm --filter @walletchan/extension lint",
    "typecheck:extension": "pnpm --filter @walletchan/extension typecheck",
    "typecheck:extension:ui": "pnpm --filter @walletchan/extension typecheck:ui",
    "typecheck:extension:qa": "pnpm --filter @walletchan/extension typecheck:qa",
    "qa:extension": "pnpm --filter @walletchan/extension qa:extension",
    "test:extension-passkey": "pnpm --filter @walletchan/extension test:passkey",
    "test:extension-ui": "pnpm --filter @walletchan/extension test:ui",
    "zip": "pnpm --filter @walletchan/extension zip",
    "zip:cws": "pnpm --filter @walletchan/extension zip:cws",
    "zip:firefox": "pnpm --filter @walletchan/extension zip:firefox",
    "sign:firefox": "pnpm --filter @walletchan/extension sign:firefox",
    "dev:domain-reputation": "pnpm --filter @walletchan/domain-reputation dev",
    "start:domain-reputation": "pnpm --filter @walletchan/domain-reputation start",
    "build:domain-reputation": "pnpm --filter @walletchan/domain-reputation build",
    "test:domain-reputation": "pnpm --filter @walletchan/domain-reputation test",
    "icons": "pnpm --filter @walletchan/extension icons",
    "release:patch": "pnpm --filter @walletchan/extension release:patch",
    "release:minor": "pnpm --filter @walletchan/extension release:minor",
    "release:major": "pnpm --filter @walletchan/extension release:major",
    "sync:addresses": "pnpm --filter @walletchan/website exec tsx scripts/sync-addresses.ts"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0"
}
